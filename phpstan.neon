includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Read the literal array returned by each model's casts() method, so
    # enum/datetime casts are known instead of falling back to the raw
    # column types from the migrations (e.g. status as plain string).
    parseModelCastsMethod: true
