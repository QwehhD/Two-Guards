{
  "info": {
    "name": "ParkAutomation - Role Middleware Verification",
    "description": "TEMPORARY collection to manually verify EnsureUserHasRole middleware and the dummy /test/* routes before real controllers exist (Tahap 3 & 4). Uses Fortify session login + Sanctum SPA cookie auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "xsrf_token",
      "value": ""
    },
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "stateful_origin",
      "value": "http://localhost:5173"
    },
    {
      "key": "admin_email",
      "value": "admin@example.com"
    },
    {
      "key": "admin_password",
      "value": "password"
    },
    {
      "key": "karyawan_email",
      "value": "karyawan@example.com"
    },
    {
      "key": "karyawan_password",
      "value": "password"
    }
  ],
  "item": [
    {
      "name": "1. Get CSRF Cookie",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sanctum/csrf-cookie",
          "host": ["{{base_url}}"],
          "path": ["sanctum", "csrf-cookie"]
        },
        "description": "Sets the XSRF-TOKEN cookie and, via the test script below, saves its decoded value into the {{xsrf_token}} collection variable. Run this once before logging in, and again if the session expires (419 errors)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Read the cookie AFTER the response arrived (reliable), not in a",
              "// pre-request script (cookies set by this same call aren't guaranteed",
              "// to be visible yet at that point in some Postman versions).",
              "const xsrfCookie = pm.cookies.get('XSRF-TOKEN');",
              "if (xsrfCookie) {",
              "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(xsrfCookie));",
              "    console.log('Saved xsrf_token collection variable.');",
              "} else {",
              "    console.warn('XSRF-TOKEN cookie not found in response - check Postman Console.');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login as Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{xsrf_token}}"
          },
          {
            "key": "Origin",
            "value": "{{stateful_origin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        },
        "description": "Requires step 1 to have run first so {{xsrf_token}} is populated. If this still 419s, open Postman Console (View > Show Postman Console) and check the request's actual X-XSRF-TOKEN header value against the XSRF-TOKEN cookie."
      }
    },
    {
      "name": "2b. Login as Karyawan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{xsrf_token}}"
          },
          {
            "key": "Origin",
            "value": "{{stateful_origin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{karyawan_email}}\",\n  \"password\": \"{{karyawan_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        },
        "description": "Run '3. Logout' first if you were logged in as admin, then run '1. Get CSRF Cookie' again before this."
      }
    },
    {
      "name": "3. Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{xsrf_token}}"
          },
          {
            "key": "Origin",
            "value": "{{stateful_origin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/logout",
          "host": ["{{base_url}}"],
          "path": ["logout"]
        },
        "description": "Clears the session so you can switch users. Run '1. Get CSRF Cookie' again afterwards."
      }
    },
    {
      "name": "4. GET /api/test/admin-only",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{stateful_origin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/test/admin-only",
          "host": ["{{base_url}}"],
          "path": ["api", "test", "admin-only"]
        },
        "description": "Expected: 200 {\"message\": \"Halo admin\"} when logged in as admin.\n403 {\"message\": \"Forbidden\"} when logged in as karyawan.\n401 when not authenticated.\n\nThe Origin header is required so Sanctum recognizes this as a stateful (cookie-based) request per SANCTUM_STATEFUL_DOMAINS - without it, auth:sanctum ignores the session cookie entirely and returns 401 Unauthenticated even when logged in."
      }
    },
    {
      "name": "5. GET /api/test/any-role",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{stateful_origin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/test/any-role",
          "host": ["{{base_url}}"],
          "path": ["api", "test", "any-role"]
        },
        "description": "Expected: 200 {\"message\": \"Halo semua role\"} for both admin and karyawan.\n401 when not authenticated."
      }
    }
  ]
}
